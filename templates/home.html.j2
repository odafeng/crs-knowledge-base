{% extends "base.html.j2" %}
{% from "_macros.html.j2" import icon, entry, news_card, status, ai_chip, phrases with context %}
{% from "_figure.html.j2" import figure %}
{% block title %}{{ site.SITE_NAME }}｜{{ site.TAGLINE }}{% endblock %}
{% block main %}
<h1 class="visually-hidden">{{ site.SITE_NAME }}：{{ site.TAGLINE }}</h1>
{% if lead %}
<section class="lead on-field" aria-labelledby="lead-title">
  <svg class="lead__motif" viewBox="0 0 800 60" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M0 8h120v8h90v7h140v9h110v6h150v8h190"/><path d="M0 8h70v14h80v12h110v10h140v8h400"/></svg>
  <div class="container">
    <p class="lead__dateline"><time datetime="{{ last_updated.isoformat() }}">{{ last_updated.year }} 年 {{ last_updated.month }} 月 {{ last_updated.day }} 日</time><span>本週新增 {{ week_papers }} 篇文獻、{{ week_news }} 則消息</span></p>
    <div class="lead__grid">
      <div>
        <p class="eyebrow"><span class="eyebrow__flag">頭條</span><a class="eyebrow__topic" href="{{ url(topic_path(lead.paper.topic)) }}">{{ lead.paper.topic.label }}</a><span>{{ lead.paper.journal }} {{ lead.paper.year }}</span></p>
        <h2 class="lead__headline" id="lead-title"><a href="{{ url(news_path(lead)) }}">{{ phrases(lead) }}</a></h2>
        <p class="lead__dek">{{ lead.dek }}</p>
        <div class="lead__actions"><a class="btn btn--primary" href="{{ url(news_path(lead)) }}">讀這則消息{{ icon("arrow") }}</a>{{ ai_chip("AI 新聞稿") }}{% if lead.unreviewed %}{{ ai_chip("AI 未審") }}{% endif %}</div>
      </div>
      {% if lead.figures %}{{ figure(lead) }}{% endif %}
    </div>
  </div>
</section>
{% endif %}
<div class="container">
  {% if more %}
  <section class="band" aria-labelledby="more-title">
    <div class="section-head"><h2 id="more-title">更多消息</h2><a href="{{ url('/news/') }}">全部消息</a></div>
    <ul class="news-grid">{% for item in more %}{{ news_card(item) }}{% endfor %}</ul>
  </section>
  {% endif %}
  <div class="band home-split">
    <section aria-labelledby="log-title">
      <div class="section-head"><h2 id="log-title">新收錄文獻</h2><a href="{{ url('/updates/') }}">全部 {{ paper_count }} 篇</a></div>
      <ol class="entries">{% for u in updates %}{{ entry(u) }}{% endfor %}</ol>
    </section>
    <aside class="home-rail" aria-label="訂閱、主題與給付現況">
      {% include "_alerts.html.j2" %}
      <section aria-labelledby="topics-title">
        <h2 class="rail-title" id="topics-title">主題</h2>
        <ul class="topic-list">
          {% for topic in topics %}<li><a href="{{ url(topic_path(topic)) }}">{{ topic.label }}</a><span>{{ kb.by_topic(topic) | length }} 篇</span></li>{% endfor %}
          {% for section in kb.robotic %}<li><a href="{{ url('/robotic/' ~ section.page.slug ~ '/') }}">{{ section.page.title }}</a><span>{{ section.cards | length }} 則</span></li>{% endfor %}
        </ul>
      </section>
      <section aria-labelledby="board-title">
        <h2 class="rail-title" id="board-title">核准與給付現況</h2>
        <ul class="board">
          {% for row in kb.regulatory %}<li><a href="{{ url(topic_path(row.topic)) }}">{{ row.regimen }}</a>
            <span class="board__states">{{ status("fda", row.fda, "FDA ") }}{{ status("tfda", row.tfda, "TFDA ") }}{{ status("nhi", row.nhi, "健保 ") }}</span></li>{% endfor %}
        </ul>
      </section>
    </aside>
  </div>
</div>
{% endblock %}
