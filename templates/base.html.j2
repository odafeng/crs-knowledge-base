{% from "_macros.html.j2" import icon, logo with context %}
{% set nav = [("最新消息", "/news/", "news"), ("文獻", "/updates/", "papers"), ("主題", "/topics/", "topics"), ("訂閱", "/subscribe/", "subscribe"), ("關於", "/about/", "about")] %}
{% set tabs = [("首頁", "/", "home", "home"), ("消息", "/news/", "news", "news"), ("文獻", "/updates/", "papers", "list"), ("主題", "/topics/", "topics", "grid"), ("訂閱", "/subscribe/", "subscribe", "bell")] %}
{% if path == "/" %}{% set area = "home" %}
{% elif path.startswith("/news/") %}{% set area = "news" %}
{% elif path.startswith(("/updates/", "/papers/")) %}{% set area = "papers" %}
{% elif path.startswith(("/topics/", "/mcrc/", "/robotic/")) %}{% set area = "topics" %}
{% elif path.startswith("/subscribe/") %}{% set area = "subscribe" %}
{% else %}{% set area = "about" %}{% endif %}
<!doctype html>
<html lang="{{ site.LANG }}" data-root="{{ url('/') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#0E2270">
<title>{% block title %}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.DESCRIPTION }}{% endblock %}">
<link rel="canonical" href="{{ absolute(path) }}">
{% if noindex %}<meta name="robots" content="noindex, follow">
{% endif %}
<meta property="og:type" content="{% block og_type %}website{% endblock %}">
<meta property="og:site_name" content="{{ site.SITE_NAME }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ absolute(path) }}">
<meta property="og:image" content="{{ absolute('/icons/icon-512.png') }}">
<meta property="og:locale" content="zh_TW">
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="{{ site.SITE_NAME }}｜全部更新（RSS）" href="{{ url('/rss.xml') }}">
{% if feed_path(site.NEWS_CATEGORY) in feeds %}<link rel="alternate" type="application/rss+xml" title="{{ site.SITE_NAME }}｜最新消息（RSS）" href="{{ url(feed_path(site.NEWS_CATEGORY)) }}">
{% endif %}
<link rel="alternate" type="application/atom+xml" title="{{ site.SITE_NAME }}｜全部更新（Atom）" href="{{ url('/atom.xml') }}">
<link rel="alternate" type="application/feed+json" title="{{ site.SITE_NAME }}｜全部更新（JSON Feed）" href="{{ url('/feed.json') }}">
{% block feed_links %}{% endblock %}
<link rel="icon" href="{{ url('/favicon.png') }}" type="image/png">
<link rel="apple-touch-icon" href="{{ url('/icons/icon-192.png') }}">
<link rel="manifest" href="{{ url('/manifest.webmanifest') }}">
<link rel="preload" href="{{ url('/fonts/archivo-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
{% if site.PUSH_PUBLIC_KEY %}<meta name="push-key" content="{{ site.PUSH_PUBLIC_KEY }}">
<meta name="push-api" content="{{ site.PUSH_API }}">
<meta name="push-api-key" content="{{ site.PUSH_API_KEY }}">
{% if site.PUSH_PREVIEW %}<meta name="push-preview" content="1">
{% endif %}
{% endif %}
<script>(function(){var d=document.documentElement,t,f;try{t=localStorage.getItem('theme');f=localStorage.getItem('fontSize');}catch(e){}if(t)d.dataset.theme=t;if(f&&f!=='md')d.dataset.fontSize=f;})();</script>
<link rel="stylesheet" href="{{ url('/styles/site.css') }}">
<script type="application/ld+json">{{ jsonld | tojson }}</script>
</head>
<body>
<a class="skip-link" href="#main">跳到主要內容</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="{{ url('/') }}">{{ logo() }}<span class="brand__text"><span class="brand__name">{{ site.SITE_NAME }}</span><span class="brand__desc">{{ site.TAGLINE }}</span></span></a>
    <nav class="site-nav" aria-label="主要導覽">
      {% for label, href, key in nav %}<a href="{{ url(href) }}"{% if area == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    </nav>
    <a class="btn btn--quiet btn--icon" href="{{ url('/updates/') }}#q" aria-label="搜尋消息與文獻">{{ icon("search") }}</a>
    <button class="btn btn--quiet btn--icon" type="button" data-push-toggle hidden aria-label="開啟最新消息推播">{{ icon("bell") }}</button>
    <button class="btn btn--quiet btn--icon header-wide" type="button" data-action="toggle-theme" aria-label="切換深色模式">{{ icon("theme") }}</button>
  </div>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p>本站供醫療專業人員教育與臨床參考，不構成醫療建議。新聞稿由 AI 撰寫，部分文獻由 AI 整理；標示「尚未經人工審核」或「AI 未審」的內容可能有誤，臨床決策請以原始文獻與現行指引為準。</p>
      <nav aria-label="頁尾導覽"><a href="{{ url('/about/') }}">關於本站與 AI 使用說明</a><a href="{{ url('/subscribe/') }}">推播與 RSS 訂閱</a><a href="{{ url('/updates/') }}">全部文獻</a></nav>
      <p>最後更新 <time datetime="{{ last_updated.isoformat() }}">{{ last_updated.isoformat() }}</time></p>
    </div>
    <div class="display-settings"><span id="text-size-label">文字大小</span><span class="segmented" role="group" aria-labelledby="text-size-label">{% include "_fontsize.html.j2" %}</span><button class="btn btn--secondary" type="button" data-action="toggle-theme">{{ icon("theme") }}深色模式</button></div>
  </div>
</footer>
<nav class="tabbar" aria-label="分頁導覽">
  {% for label, href, key, glyph in tabs %}<a href="{{ url(href) }}"{% if area == key %} aria-current="page"{% endif %}>{{ icon(glyph) }}{{ label }}</a>{% endfor %}
</nav>
<script type="module" src="{{ url('/scripts/prefs.js') }}"></script>
<script type="module" src="{{ url('/scripts/offline.js') }}"></script>
<script type="module" src="{{ url('/scripts/push.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
