{# A story's numbers, drawn to scale. Positions come from sitegen/figures.py; values are printed as text beside every mark. #}

{% macro _numbers(f) %}
<dl class="stats">{% for s in f.stats %}<div class="stat"><dt class="stat__label">{{ s.label }}</dt><dd class="stat__value num">{{ s.value }}<span class="stat__unit">{{ s.unit }}</span></dd></div>{% endfor %}</dl>
{% endmacro %}

{% macro _compare(f) %}
<ul class="legend" aria-hidden="true"><li>{{ f.arm_a }}</li><li>{{ f.arm_b }}</li></ul>
{% for row in f.rows %}
<table class="compare">
  <caption>{{ row.label }} <span>（{{ row.unit }}）</span></caption>
  <tbody>
    <tr><th scope="row" class="visually-hidden">{{ f.arm_a }}</th><td><span class="bar bar--a" style="--w:{{ f.width(row, row.a) }}%"><span class="bar__value num">{{ fmt(row.a) }}</span></span></td></tr>
    <tr><th scope="row" class="visually-hidden">{{ f.arm_b }}</th><td><span class="bar" style="--w:{{ f.width(row, row.b) }}%"><span class="bar__value num">{{ fmt(row.b) }}</span></span></td></tr>
  </tbody>
</table>
{% endfor %}
{% endmacro %}

{% macro _meters(f) %}
<ul class="meters">{% for m in f.rows %}<li class="meter"><span class="meter__label">{{ m.label }}</span><span class="meter__value num">{{ fmt(m.percent) }}%</span><span class="meter__track" aria-hidden="true"><span class="meter__fill" style="--w:{{ m.percent }}%"></span></span>{% if m.detail %}<span class="meter__detail">{{ m.detail }}</span>{% endif %}</li>{% endfor %}</ul>
{% endmacro %}

{% macro _interval(f) %}
<div class="interval__head"><span class="interval__label">{{ f.label }}</span><span class="interval__value"><span class="num">{{ fmt(f.point) }}</span>（95% CI {{ fmt(f.low) }}–{{ fmt(f.high) }}）</span></div>
<div class="interval__scale" aria-hidden="true">
  <div class="interval__plot"><span class="interval__ref" style="--x:{{ f.x(f.reference) }}%"></span><span class="interval__whisker" style="--from:{{ f.x(f.low) }}%;--to:{{ f.x(f.high) }}%"></span><span class="interval__point" style="--x:{{ f.x(f.point) }}%"></span></div>
  <div class="interval__ticks">{% for label, x in f.ticks %}<span style="--x:{{ x }}%">{{ label }}</span>{% endfor %}</div>
</div>
{% if f.note %}<p class="interval__note">{{ f.note }}</p>{% endif %}
{% endmacro %}

{% macro figure(item, title="關鍵數字") %}
<figure class="figure">
  <p class="figure__title">{{ title }}</p>
  {% for f in item.figures %}
  <div class="figure__block">
    {% if f.kind == "numbers" %}{{ _numbers(f) }}{% elif f.kind == "compare" %}{{ _compare(f) }}{% elif f.kind == "meters" %}{{ _meters(f) }}{% else %}{{ _interval(f) }}{% endif %}
  </div>
  {% endfor %}
  {% if item.figure_note %}<figcaption class="figure__caption">{{ item.figure_note }}</figcaption>{% endif %}
</figure>
{% endmacro %}
