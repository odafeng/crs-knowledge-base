{% extends "base.html.j2" %}
{% from "_macros.html.j2" import breadcrumb with context %}
{% set heading = crumbs[-1][0] %}
{% block title %}{{ heading }}｜{{ site.SITE_NAME }}{% endblock %}
{% block description %}依主題整理的試驗實證。{% endblock %}
{% block main %}
<div class="container page">
  {{ breadcrumb(crumbs) }}
  <header class="page-head">
    <h1>{{ heading }}</h1>
    <p class="page-head__lead">每個主題有核准與給付現況、治療現況與全部文獻。</p>
  </header>
  {% for name, href, kind in groups %}
  <section class="page__section" aria-labelledby="group-{{ kind }}">
    <h2 id="group-{{ kind }}">{% if groups | length > 1 %}<a href="{{ url(href) }}">{{ name }}</a>{% else %}主題{% endif %}</h2>
    <ul class="tile-grid">
      {% if kind == "mcrc" %}{% for topic in topics %}{% set papers = kb.by_topic(topic) %}
      <li class="tile"><p class="tile__count"><span class="num">{{ papers | length }}</span>篇文獻</p>
        <h3 class="tile__title"><a href="{{ url(topic_path(topic)) }}">{{ topic.label }}</a></h3>
        {% if papers %}<p class="tile__text">最新：{{ papers[0].regimen }}（{{ papers[0].journal }} {{ papers[0].year }}）</p>{% endif %}</li>
      {% endfor %}{% else %}{% for section in kb.robotic %}
      <li class="tile"><p class="tile__count"><span class="num">{{ section.cards | length }}</span>則實證整理</p>
        <h3 class="tile__title"><a href="{{ url('/robotic/' ~ section.page.slug ~ '/') }}">{{ section.page.title }}</a></h3>
        <p class="tile__text">證據演進有 {{ section.timeline | length }} 個時間點</p></li>
      {% endfor %}{% endif %}
    </ul>
  </section>
  {% endfor %}
</div>
{% endblock %}
