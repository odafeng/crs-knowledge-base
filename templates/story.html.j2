{% extends "base.html.j2" %}
{% from "_macros.html.j2" import breadcrumb, news_card, ai_chip, icon, phrases with context %}
{% from "_figure.html.j2" import figure %}
{% block title %}{{ item.headline }}｜{{ site.SITE_NAME }}{% endblock %}
{% block description %}{{ item.dek }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block feed_links %}{% if feed_path(item.paper.topic.slug) in feeds %}<link rel="alternate" type="application/rss+xml" title="{{ site.SITE_NAME }}｜{{ item.paper.topic.label }}（RSS）" href="{{ url(feed_path(item.paper.topic.slug)) }}">
{% endif %}{% endblock %}
{% block main %}
<article class="container page">
  {{ breadcrumb(crumbs) }}
  <div class="split">
   <div>
    <header class="story__head">
      <p class="eyebrow"><a class="eyebrow__topic" href="{{ url(topic_path(item.paper.topic)) }}">{{ item.paper.topic.label }}</a><time datetime="{{ item.published_at.isoformat() }}">{{ item.published_at.isoformat() }}</time></p>
      <h1 class="phrased">{{ phrases(item) }}</h1>
      <p class="story__dek">{{ item.dek }}</p>
      <p class="story__byline">{{ ai_chip("AI 新聞稿") }}<span>依本站的文獻條目撰寫{% if item.unreviewed %}，尚未經人工審核{% endif %}</span></p>
    </header>
    {% if item.figures %}{{ figure(item) }}{% endif %}
    <div class="story__body">
      {% for section in item.body %}<h2>{{ section.heading }}</h2><p>{{ section.text }}</p>{% endfor %}
    </div>
   </div>
   <aside class="split__rail" aria-label="原始文獻與說明">
    <section class="source" aria-labelledby="source-title">
      <h2 id="source-title">原始文獻</h2>
      <p class="source__title">{{ item.paper.regimen }}</p>
      <p class="eyebrow"><span>{{ item.paper.journal }} {{ item.paper.year }}</span><span>{{ item.paper.study_type }}</span>{% if item.paper.n %}<span>n = {{ item.paper.n }}</span>{% endif %}<span>來源：{{ source_labels[item.paper.source] }}</span></p>
      <div class="source__actions"><a class="btn btn--primary" href="{{ url(paper_path(item.paper)) }}">看文獻整理</a>{% if item.paper.doi %}<a class="btn btn--secondary" href="https://doi.org/{{ item.paper.doi }}" rel="noopener">{{ icon("external") }}看原文（DOI）</a>{% endif %}</div>
    </section>
    {% if item.unreviewed %}<div class="callout callout--ai" role="note">{{ icon("spark") }}<p>這則新聞稿由 AI 撰寫，尚未經人工審核。內容可能有誤，臨床判斷請以原文為準。</p></div>{% endif %}
   </aside>
  </div>
  {% if others %}
  <section class="page__section" aria-labelledby="others-title">
    <h2 id="others-title">其他消息</h2>
    <ul class="news-grid">{% for other in others %}{{ news_card(other) }}{% endfor %}</ul>
  </section>
  {% endif %}
</article>
{% endblock %}
