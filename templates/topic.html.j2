{% extends "base.html.j2" %}
{% from "_macros.html.j2" import icon, paper_card, news_card, breadcrumb, status with context %}
{% block title %}{{ topic.title }}｜{{ site.SITE_NAME }}{% endblock %}
{% block description %}{{ topic.title }}的試驗實證，共 {{ papers | length }} 篇。{% endblock %}
{% block feed_links %}{% if feed_path(topic.slug) in feeds %}<link rel="alternate" type="application/rss+xml" title="{{ site.SITE_NAME }}｜{{ topic.label }}（RSS）" href="{{ url(feed_path(topic.slug)) }}">
{% endif %}{% endblock %}
{% block main %}
<div class="container page">
  {{ breadcrumb(crumbs) }}
  <header class="page-head">
    <h1>{{ topic.title }}</h1>
    <p class="page-head__lead">共 {{ papers | length }} 篇文獻。{% if feed_path(topic.slug) in feeds %}<a href="{{ url(feed_path(topic.slug)) }}">用 RSS 訂閱這個主題</a>{% endif %}</p>
  </header>
  {% if stories %}
  <section aria-labelledby="stories">
    <h2 class="visually-hidden" id="stories">這個主題的消息</h2>
    <ul class="news-grid">{% for item in stories %}{{ news_card(item) }}{% endfor %}</ul>
  </section>
  {% endif %}
  {% if regulatory %}
  <section class="page__section" aria-labelledby="reg">
    <h2 id="reg">核准與給付現況</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="核准與給付現況表格，可左右捲動"><table class="table">
      <thead><tr><th scope="col">方案</th><th scope="col">FDA</th><th scope="col">TFDA</th><th scope="col">健保</th><th scope="col">查核日</th></tr></thead>
      <tbody>{% for r in regulatory %}<tr><td>{{ r.regimen }}{% if r.note %}<span class="note">{{ r.note }}</span>{% endif %}</td><td>{{ status("fda", r.fda) }}</td><td>{{ status("tfda", r.tfda) }}</td><td>{{ status("nhi", r.nhi) }}</td><td>{{ r.checked_at.isoformat() }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </section>
  {% endif %}
  {% if soc %}
  <section class="page__section" aria-labelledby="soc">
    <h2 id="soc">治療現況</h2>
    {% for card in soc %}
    <details class="accordion"{% if loop.first %} open{% endif %}><summary>{{ card.title }}</summary>
      <div class="richtext" tabindex="0" role="group" aria-label="{{ card.title }}">{{ card.body_html | safe }}</div>
      <p class="note">最近複查 {{ card.reviewed_at.isoformat() }}</p></details>
    {% endfor %}
  </section>
  {% endif %}
  <section class="page__section" aria-labelledby="papers">
    <h2 id="papers">文獻</h2>
    <ul class="paper-list">{% for paper in papers %}{{ paper_card(paper) }}{% endfor %}</ul>
  </section>
</div>
{% endblock %}
