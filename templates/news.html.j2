{% extends "base.html.j2" %}
{% from "_macros.html.j2" import breadcrumb, key_stat, ai_chip, icon, phrases with context %}
{% block title %}最新消息｜{{ site.SITE_NAME }}{% endblock %}
{% block description %}新文獻的新聞稿，共 {{ news | length }} 則。由 AI 依本站的文獻條目撰寫並標示。{% endblock %}
{% block main %}
<div class="container page">
  {{ breadcrumb(crumbs) }}
  <header class="page-head">
    <h1>最新消息</h1>
    <p class="page-head__lead">重要的新文獻會寫成一則消息：發生了什麼、關鍵數字、為什麼重要、有什麼限制。這些新聞稿由 AI 依本站的文獻條目撰寫。</p>
  </header>
  <div class="page__narrow">{% include "_alerts.html.j2" %}</div>
  <ol class="news-list page__section">
    {% for item in news %}
    <li class="news-row">
      <p class="eyebrow"><time datetime="{{ item.published_at.isoformat() }}">{{ item.published_at.isoformat() }}</time><a class="eyebrow__topic" href="{{ url(topic_path(item.paper.topic)) }}">{{ item.paper.topic.label }}</a><span>{{ item.paper.journal }} {{ item.paper.year }}</span>{{ ai_chip("AI 新聞稿") }}{% if item.unreviewed %}{{ ai_chip("AI 未審") }}{% endif %}</p>
      <h2 class="phrased"><a href="{{ url(news_path(item)) }}">{{ phrases(item) }}</a></h2>
      <p class="news-row__dek">{{ item.dek }}</p>
      {{ key_stat(item, "news-row__stat") }}
    </li>
    {% endfor %}
  </ol>
</div>
{% endblock %}
