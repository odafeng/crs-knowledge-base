# CRS Knowledge Base — Paper Watch Pipeline
# Copy this file to .env and fill in your keys

# Required: Anthropic API key for AI classification
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: NCBI API key (raises PubMed rate limit from 3/s to 10/s)
# Register at https://www.ncbi.nlm.nih.gov/account/settings/
# See README section below for step-by-step instructions
NCBI_API_KEY=

# Optional: GitHub token (auto-provided in GitHub Actions)
# Only needed for local testing of issue creation
GH_TOKEN=
